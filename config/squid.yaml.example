# Restart required for all changes: bin/start.sh --restart

server:
  host: "127.0.0.1"
  port: 8000
  # Additional directories the file viewer may serve from. ~/.squid is always allowed.
  # /tmp/squid is substituted with /tmp/<your-username>/squid by start.sh on first run.
  localfile_roots:
    - "~/.squid"
    - "/tmp/squid"

agent:
  first_byte_timeout: 300
  response_timeout: 1800

# A driver is Squid's coded coding-agent integration. A backend is a configured
# driver instance: endpoint, credentials, gauge, args/settings, color, optional
# default model, and optional protocol. Named agents then choose backend + model
# override + cwd.
# Supported drivers: claude, codex, cursor, opencode.
# Supported protocols: oneshot-cli, interactive-cli, interactive-pty.
backends:
  claude:
    driver: claude
    protocol: oneshot-cli
    label: Claude
    color: "#AE5332"
    gauge: claude

  # Experimental Claude Code streaming-input mode. Use agent "clive" to compare
  # against the default one-turn CLI process model.
  claude-live:
    driver: claude
    protocol: interactive-cli
    interactive:
      # Seconds before Squid stops an idle live CLI process. The native
      # session is preserved and resumed on the next turn. Set to 0 to disable.
      idle_timeout_seconds: 3600
    label: Claude Live
    color: "#C46A3A"
    gauge: claude

  codex:
    driver: codex
    # protocol: interactive-cli  # structured exec/resume JSONL, not TUI scraping
    label: Codex
    color: "#7070A0"
    gauge: codex

  cursor:
    driver: cursor
    # protocol: interactive-cli  # structured stream-json print/resume
    label: Cursor
    color: "#FFFFFF"
    gauge: cursor

  opencode:
    driver: opencode
    # protocol: interactive-cli  # structured json run/session
    label: OpenCode
    color: "#CFCECD"
    gauge:
      type: static
      text: Free tier
      title: OpenCode-managed limits

  # DeepSeek through Claude Code's Anthropic-compatible transport.
  # Get an API key at https://platform.deepseek.com/api_keys, then fill in one of:
  #   api_key: "sk-..."                 # inline string
  #   api_key: {env: DEEPSEEK_API_KEY}  # read from environment variable
  # deepcla:
  #   driver: claude
  #   label: DeepSeek
  #   color: "#4D9DE0"
  #   provider: deepseek
  #   base_url: "https://api.deepseek.com/anthropic"
  #   api_key: "sk-..."
  #   model: deepseek-chat  # backend default; an agent may override it
  #   gauge: deepseek

  # Canonical base_url/api_key fields are translated into driver-specific
  # environment and settings. Raw env/settings/args remain available as escapes.
  #
  # Example: local model served by vllm-mlx (or any OpenAI-compatible server).
  #   base_url must point to the server's /v1 endpoint.
  #   model must match the --served-model-name passed to the server; codex cannot
  #   auto-discover the model name from a local server's /v1/models response.
  # qwen:
  #   driver: codex
  #   label: Qwen
  #   color: "#10A37F"
  #   provider: qwen
  #   base_url: "http://127.0.0.1:9000/v1"
  #   model: qwen2.5-coder-7b-4bit  # must match --served-model-name on the server
  #   gauge:
  #     type: static
  #     text: Local
  #     title: No provider quota
