# Restart required for all changes: bin/start.sh --restart

server:
  # Must stay loopback-only. Do not set this to 0.0.0.0, a public IP, LAN IP,
  # or Tailscale IP; Squid rejects non-loopback hosts at startup and in the
  # config editor.
  host: "127.0.0.1"
  port: 8000
  # Frequently visited directories shown in the file viewer's root list. The
  # file browser can reach any path you have OS access to, same as the agent;
  # this list is just for quick access, not an access restriction. ~/.squid
  # is always included.
  # /tmp/squid is substituted with /tmp/<your-username>/squid by start.sh on first run.
  localfile_roots:
    - "~/.squid"
    - "/tmp/squid"

agent:
  first_byte_timeout: 600
  response_timeout: 3600
  # How long a native `!` shell command may run before Squid stops it (ADR-0038).
  shell_timeout: 120

# Temporary migration control for ADR-0040. `auto` prefers WebSocket for
# migrated live features and falls back to their compatibility SSE path.
realtime:
  transport: auto  # auto | websocket | sse

updates:
  # What to do when a newer AgentSquid release is available and the user restarts.
  # ask: prompt in the restart modal; always: run `pipx upgrade agentsquid`;
  # never: restart without attempting an upgrade.
  install_on_restart: ask

auth:
  # The macOS keychain-unlock auth-session mode (fixes "Your macOS login
  # keychain is locked" on `cursor-agent login`) is loopback-only by default,
  # even though this server is reachable over the tailnet via `tailscale
  # serve` too. This check fails closed: any request proxied through
  # `tailscale serve` is treated as remote and refused, even from your own
  # tailnet URL on the same machine — open the app at its loopback address
  # (http://127.0.0.1:<port>) to unlock, or set this true only if you accept
  # typing your Mac login-keychain password from another device on your
  # tailnet.
  allow_remote_keychain_unlock: false

worktree:
  # Per-turn code-root isolation. Set enabled: false to use direct writes.
  enabled: true
  # Symlink allowlisted Git-ignored dependency/cache directories such as
  # .venv/node_modules into turn worktrees so local tools do not need
  # reinstalling there.
  auto_link_ignored_dirs: true
  # Optional fallback for dependency/cache directory names Git does not report
  # as ignored. Leave unset; add only dependency/cache names Squid misses.
  # dependency_dirs:
  #   - custom-cache-dir
  # Whether a new turn should start from the source checkout's uncommitted
  # state. true snapshots dirty/untracked files into the turn seed, so files
  # you just edited or added are visible to the agent without committing first.
  # This is clearer for side-by-side IDE editing, but costs an extra Git index
  # scan/stat pass over the source checkout at turn start. Set false to seed
  # turn directories from HEAD only; promotion still snapshots the current
  # source checkout at turn end in both modes, so false does not allow Squid to
  # blindly overwrite dirty source files.
  track_dirty_changes: true

# Squid Echo: an extra "echo" harness that dispatches through the real
# HTTP/queue/flow-continuation path but never runs a real CLI — it just
# echoes the prompt back instantly. For previewing how a Squid Flow route
# actually executes (joins, round-trips, broadcasts, ...) at zero cost/time
# before pointing it at a real agent. Off by default; register a normal
# agent with harness `echo` once this is on.
# test_harness_enabled: true

# A harness is one of Squid's coded coding-agent CLI integrations. The
# supported harness set is fixed in code; these YAML entries configure each
# harness's defaults. A named agent picks harness + provider + model + cwd
# directly in the UI. There is no `backends:` section anymore.
harnesses:
  claudecode:
    protocol:
      type: oneshot-cli
    default_provider: anthropic
    supported_apis: [/v1/messages]

  codex:
    protocol:
      type: oneshot-cli
    default_provider: openai
    supported_apis: [/v1/responses]

  cursor:
    protocol:
      type: oneshot-cli
    default_provider: cursor
    supported_apis: [/native/cursor]

  # default_provider: nvidia below is what a fresh install gets when the
  # `ollama` binary isn't found. bin/install.sh checks for it and, when
  # present, rewrites these two lines to `default_provider: ollama` in the
  # copy it writes to ~/.squid/squid.yaml — this file on disk always shows
  # the no-binary fallback. See the `ollama` provider entry below and
  # docs/decisions/0037-ollama-local-model-harness-and-queueing.md.
  opencode:
    protocol:
      type: oneshot-cli
    default_provider: nvidia
    supported_apis: [/v1/chat/completions, /v1/messages]

  pi:
    protocol:
      type: oneshot-cli
    default_provider: nvidia
    supported_apis: [/v1/messages, /v1/responses, /v1/chat/completions]

# A provider owns the API endpoint: label, color (also used as the quota-pool
# identity for its gauge), base_url, auth (api_key or subscription), gauge,
# and an optional `models:` suggestion list for the agent-creation dropdown
# (freeform entry always works too — this list is never server-validated).
providers:
  # Native Claude Code. Uses the local `claude` CLI subscription/login.
  anthropic:
    label: Anthropic
    color: "#AE5332"
    auth: {type: subscription}
    gauge: claude
    supported_apis: [/v1/messages]
    models:
      - claude-opus-4-8
      - claude-opus-4-6
      - claude-sonnet-5
      - claude-sonnet-4-6
      - claude-haiku-4-5

  # Native Codex. Uses the local `codex` CLI subscription/login.
  openai:
    label: OpenAI
    color: "#7070A0"
    auth: {type: subscription}
    gauge: codex
    supported_apis: [/v1/responses]

  cursor:
    label: Cursor
    color: "#8F8D8D"
    auth: {type: subscription}
    gauge: cursor
    supported_apis: [/native/cursor]

  # OpenCode's own free-tier routing — zero config, no api key. Not the
  # default provider for the opencode harness (nvidia is, see below), kept
  # available for backward compatibility.
  opencode:
    label: OpenCode
    color: "#CFCECD"
    auth: {type: subscription}
    gauge:
      type: static
      text: Free tier
      title: no reset
    supported_apis: [/v1/chat/completions, /v1/messages]

  # NVIDIA NIM — free access to top open models via an NVIDIA API key. This
  # is the default provider for opencode and pi. Get a key at
  # https://build.nvidia.com, then fill in one of:
  #   api_key: "nvapi-..."              # inline string
  #   api_key: {env: NIM_API_KEY}       # read from environment variable
  nvidia:
    label: NVIDIA
    color: "#76B900"
    base_url: "https://integrate.api.nvidia.com/v1"
    supported_apis: [/v1/messages, /v1/responses]
    auth:
      type: api_key
      api_key: {env: NIM_API_KEY}
    # id must stay "nvidia" — the pi harness embeds it as the "provider/model"
    # prefix in --model (see https://pi.dev/docs/latest/providers), and
    # opencode's -m uses the same "provider/model" convention.
    gauge:
      type: static
      text: Free tier
      title: no reset
    models:
      - deepseek-ai/deepseek-v4-pro
      - nvidia/nemotron-4-340b
      - meta/llama-3.1-405b-instruct
      - deepseek-ai/deepseek-r1

  # DeepSeek through Claude Code's Anthropic-compatible transport.
  # Get an API key at https://platform.deepseek.com/api_keys, then set
  # DEEPSEEK_API_KEY in the environment.
  # deepseek:
  #   label: DeepSeek
  #   color: "#4D9DE0"
  #   base_url: "https://api.deepseek.com/anthropic"
  #   supported_apis: [/v1/messages]
  #   auth:
  #     type: api_key
  #     api_key: {env: DEEPSEEK_API_KEY}
  #   gauge: deepseek
  #   models: [deepseek-v4-pro]

  # Kimi (Moonshot AI) through Claude Code's Anthropic-compatible transport.
  # Get an API key at https://platform.moonshot.ai/console/api-keys, then set
  # MOONSHOT_API_KEY in the environment.
  # kimi:
  #   label: Kimi
  #   color: "#4D6BFE"
  #   base_url: "https://api.moonshot.ai/anthropic"
  #   supported_apis: [/v1/messages]
  #   auth:
  #     type: api_key
  #     api_key: {env: MOONSHOT_API_KEY}
  #   gauge: kimi
  #   models: [kimi-k3]

  # Fireworks AI through its Anthropic-compatible transport.
  # Get an API key at https://app.fireworks.ai/settings/users/api-keys, then
  # set FIREWORKS_API_KEY in the environment.
  # fireworks:
  #   label: Fireworks AI
  #   color: "#6720ff"
  #   base_url: "https://api.fireworks.ai/inference"
  #   supported_apis: [/v1/messages, /v1/responses, /v1/chat/completions]
  #   auth:
  #     type: api_key
  #     api_key: {env: FIREWORKS_API_KEY}
  #   gauge:
  #     type: static
  #     text: Pay as you go
  #     title: no reset
  #   models: [accounts/fireworks/models/deepseek-v3p1]

  # Baseten Model APIs through its Anthropic-compatible transport.
  # Get a workspace API key at https://app.baseten.co/settings/api_keys, then
  # set BASETEN_API_KEY in the environment. Custom Truss deployments use
  # deployment-specific URLs and should be configured as separate providers.
  # baseten:
  #   label: Baseten
  #   color: "#19E76E"
  #   base_url: "https://inference.baseten.co/v1"
  #   supported_apis: [/v1/chat/completions]
  #   auth:
  #     type: api_key
  #     api_key: {env: BASETEN_API_KEY}
  #   gauge:
  #     type: static
  #     text: Pay as you go
  #     title: no reset
  #   models: [deepseek-ai/DeepSeek-V4-Pro]

  # Canonical base_url/auth.api_key fields are translated into harness-native
  # environment and settings. Raw env/settings/args remain available as
  # escapes.
  #
  # Local OpenAI-compatible model server, such as vllm-mlx. base_url must point
  # to the server's /v1 endpoint. model must match the served model name; codex
  # cannot auto-discover it from /v1/models. parallel: false is independent of
  # auth.type (see the ollama entry below and
  # docs/decisions/0037-ollama-local-model-harness-and-queueing.md) — it's set
  # here too because a single vllm-mlx process is one physical resource just
  # like a single Ollama daemon is, regardless of using api_key auth instead
  # of none. Drop it (or set true) if this server can actually serve
  # concurrent requests.
  # local:
  #   label: Local
  #   color: "#10A37F"
  #   base_url: "http://127.0.0.1:9000/v1"
  #   supported_apis: [/v1/responses]
  #   auth:
  #     type: api_key
  #     api_key: {env: LOCAL_API_KEY}
  #   parallel: false
  #   gauge:
  #     type: static
  #     text: Local
  #     title: no reset
  #   models: [qwen2.5-coder-7b-4bit]

  # Ollama (ADR-0037): a local daemon, not a hosted API — no credential to
  # supply, hence auth.type: none rather than api_key. Shipped uncommented
  # (unlike the `local` example above) because it's always safe to have
  # configured: nothing resolves to it unless a named agent is explicitly
  # pointed at it, or bin/install.sh detected the `ollama` binary and set it
  # as pi/opencode's default_provider (see the harnesses: section above).
  # `parallel: false` is what actually makes every agent resolving to this
  # provider (regardless of harness) share one serial queue lane and get
  # active load/unload on model switch, instead of the parallel-across-agents
  # behavior every other provider gets by default — see
  # docs/decisions/0037-ollama-local-model-harness-and-queueing.md. This is
  # independent of auth.type: a beefier multi-GPU box that can actually
  # serve concurrent requests can set `parallel: true` instead. Running more
  # than one local box? Give each its own provider entry (distinct name,
  # distinct base_url, e.g. ollama-gpu1/ollama-gpu2) to get independent
  # queues per physical resource.
  # /v1/chat/completions makes this compatible with pi/opencode talking to
  # Ollama as a custom provider — no ollama-specific harness needed; either
  # harness's own tool-use loop runs as normal against the local checkpoint.
  # models: gemma4:12b (first entry = agent-form default), gemma4:e4b,
  # qwen3.5:9b, and the laptop-sized qwen3.5:4b.
  ollama:
    label: Ollama
    color: "#000000"
    base_url: "http://localhost:11434/v1"
    supported_apis: [/v1/chat/completions]
    auth:
      type: none
    parallel: false  # set true instead if this box can serve concurrent local requests (multi-GPU, OLLAMA_NUM_PARALLEL, ...)
    gauge:
      type: static
      text: Local
      title: no reset
    models: [gemma4:12b, gemma4:e4b, qwen3.5:9b, qwen3.5:4b]
