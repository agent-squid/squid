# Restart required for all changes: bin/start.sh --restart

server:
  host: "127.0.0.1"
  port: 8000
  # Directories the file viewer may serve from. Empty = disabled.
  # /tmp/squid is substituted with /tmp/<your-username>/squid by start.sh on first run.
  localfile_roots:
    - "/tmp/squid"

agent:
  first_byte_timeout: 300
  response_timeout: 1800

deepseek:
  claude_key: ""   # agt-squid-claude DeepSeek key (Anthropic-compatible endpoint)
  codex_key: ""    # agt-squid-codex DeepSeek key (OpenAI-compatible endpoint)
