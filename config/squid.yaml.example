# Restart required for all changes: bin/start.sh --restart

server:
  host: "127.0.0.1"
  port: 8000
  # Directories the file viewer may serve from. Empty = disabled.
  localfile_roots:
    - "/tmp/squid"

agent:
  first_byte_timeout: 300
  response_timeout: 1800

# proxy:
#   # Route CLI subprocesses through an HTTP proxy (e.g. mitmproxy).
#   enabled: true
#   url: "http://127.0.0.1:8080"
#   ssl_cert_file: "~/.mitmproxy/mitmproxy-ca-cert.pem"
